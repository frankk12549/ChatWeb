{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node build.js",
  "rewrites": [
    {
      "source": "/((?!api/)[^.]+)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/auth.js": { "runtime": "@vercel/node@3" },
    "api/fluxos.js": { "runtime": "@vercel/node@3" },
    "api/mensagens.js": { "runtime": "@vercel/node@3" },
    "api/eventos.js": { "runtime": "@vercel/node@3" },
    "api/ping.js": { "runtime": "@vercel/node@3" }
  }
}
